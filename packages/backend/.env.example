# Google is the default provider (MODEL_PROVIDER=google, or unset).
GOOGLE_GENERATIVE_AI_API_KEY=

# Swap to a local Ollama instance instead — see packages/rag/instructions.md.
# MODEL_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_CHAT_MODEL=llama3.2:3b
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Where the sqlite file (RAG index + conversations + documents) lives.
# DB_PATH=freddy.db

# Postgres connection string — when set, the backend uses Postgres+pgvector
# instead of the local SQLite file above for everything: RAG chunks,
# documents, conversations and messages. A free-tier instance from Neon
# (neon.tech) or Supabase both work; the `vector` extension and every table
# are created automatically by the app's own startup migration — no manual
# setup beyond creating the database and pasting its connection string here.
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# PORT=8788
