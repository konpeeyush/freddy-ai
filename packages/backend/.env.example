# Google is the default provider (MODEL_PROVIDER=google, or unset).
GOOGLE_GENERATIVE_AI_API_KEY=

# Swap to a local Ollama instance instead — see packages/rag/instructions.md.
# MODEL_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_CHAT_MODEL=llama3.2:3b
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Where the sqlite file (RAG index + conversations + documents) lives.
# DB_PATH=freddy.db

# PORT=8788
